{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MullaResearchPaper",
  "description": "Validation schema for Mulla Research Library publications",
  "type": "object",
  "required": [
    "id",
    "title",
    "slug",
    "author",
    "category",
    "abstract",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^RES-[0-9]{4,}$",
      "description": "Unique research publication identifier (e.g., RES-0001, RES-0002)"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "description": "Primary academic research title"
    },
    "subtitle": {
      "type": "string",
      "description": "Secondary extended title or subtitle"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "URL-friendly slug (lowercase alphanumeric separated by hyphens)"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "default": "Mulla Md Anas Ahemad",
      "description": "Lead researcher / author name"
    },
    "category": {
      "type": "string",
      "enum": [
        "Artificial Intelligence",
        "Machine Learning",
        "Business & Management",
        "Finance & Accounting",
        "Software Development",
        "Cyber Security",
        "Science & Technology",
        "Computer Science",
        "Education & Research",
        "Digital Media & Video Editing"
      ],
      "description": "Primary academic category matching indexes/categories.json"
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "description": "Executive summary / preview description used on research cards"
    },
    "shortDescription": {
      "type": "string",
      "minLength": 10,
      "description": "Alias for description"
    },
    "abstract": {
      "type": "string",
      "minLength": 20,
      "description": "Full academic abstract"
    },
    "introduction": {
      "type": "string",
      "description": "Introductory context and foundational problem statement"
    },
    "content": {
      "type": "string",
      "description": "Complete research manuscript or extended notes"
    },
    "methodology": {
      "type": "string",
      "description": "Detailed empirical or analytical methodology"
    },
    "findings": {
      "type": "string",
      "description": "Quantitative and qualitative research findings"
    },
    "conclusion": {
      "type": "string",
      "description": "Final analytical summary and recommendations"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Academic references and bibliographic citations"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Searchable indexing keywords"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short topic tags"
    },
    "coverImage": {
      "type": "string",
      "format": "uri",
      "description": "High-resolution cover image URL (e.g., from Vercel Blob or CDN)"
    },
    "pdfUrl": {
      "type": "string",
      "description": "Direct download URL for the research paper PDF"
    },
    "publishedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Publication date in YYYY-MM-DD format"
    },
    "publicationDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Alias for publishedAt in YYYY-MM-DD format"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Language code (e.g. en)"
    },
    "readingTimeMinutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Estimated reading duration in minutes"
    },
    "readingTime": {
      "type": "string",
      "description": "Display reading time string (e.g. '10 min read')"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "Flag to display on homepage Featured section"
    },
    "status": {
      "type": "string",
      "enum": [
        "published",
        "draft",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status. Only 'published' is visible to the public."
    }
  },
  "additionalProperties": true
}
